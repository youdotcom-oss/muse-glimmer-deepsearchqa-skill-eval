{
  "name": "deepsearchqa-skill-eval-template",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "scaffold": "bun run scripts/scaffold.ts",
    "generate": "bun run scripts/generate.ts",
    "grade": "bun run scripts/grade.ts",
    "eval": "bun run scaffold && bun run generate && bun run grade",
    "ab": "bun run scripts/ab-grid.ts",
    "export-results": "bun run scripts/export-results.ts",
    "download": "uv run scripts/download.py",
    "upload": "uv run scripts/upload.py",
    "query": "bun run scripts/query.ts",
    "analysis": "bun run analysis/index.ts > analysis/README.md",
    "check": "bun run typecheck && bun test && bun run biome",
    "biome": "biome check .",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@plaited/agent-eval-harness": "^1.0.1",
    "typebox": "^1.3.30"
  }
}
